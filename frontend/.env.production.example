# Production environment variables for the Corpus frontend (Vercel).
#
# Set the real value in the Vercel project's Environment Variables settings
# (Production, and Preview if needed), never commit a real production value here.

# Base URL of the deployed Corpus backend (Render). Must be reachable from the
# browser. No trailing slash.
NEXT_PUBLIC_API_BASE_URL=https://REPLACE-WITH-DEPLOYED-RENDER-URL.onrender.com

# Set true in the Vercel production environment. The token itself is never a
# NEXT_PUBLIC variable; the reviewer enters it and it remains in sessionStorage.
NEXT_PUBLIC_REVIEW_TOKEN_REQUIRED=true
