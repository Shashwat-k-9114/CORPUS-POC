# Comma-separated list of origins allowed to call this API from a browser (CORS).
# Defaults to the Next.js dev server if unset. Update for the deployed frontend origin
# when this API is deployed (Phase 9).
CORPUS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Durable foundation configuration.
CORPUS_CLIENT_ID=local-development
CORPUS_DATABASE_URL=postgresql://corpus:corpus@localhost:5432/corpus
CORPUS_BLOB_STORE_ROOT=./data/blobs
CORPUS_BLOB_STORE_BACKEND=local
CORPUS_MAX_UPLOAD_SIZE_BYTES=20971520
CORPUS_WORKER_POLL_SECONDS=2
CORPUS_WORKER_LEASE_SECONDS=30
CORPUS_WORKER_PAGE_RETRY_LIMIT=2
# Optional processing controls used for controlled failure/restart demonstrations.
CORPUS_WORKER_PAGE_DELAY_SECONDS=0
# CORPUS_WORKER_FAIL_PAGE_NUMBER=3
CORPUS_ENVIRONMENT=development
# Required when CORPUS_ENVIRONMENT=production. Never commit a real token.
# CORPUS_REVIEW_TOKEN=replace-with-a-long-random-review-token
CORPUS_RATE_LIMIT_PER_MINUTE=120

# Supabase Storage S3-compatible settings (required only when backend=s3).
# CORPUS_S3_ENDPOINT_URL=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
# CORPUS_S3_REGION=us-east-1
# CORPUS_S3_BUCKET=corpus-private
# CORPUS_S3_ACCESS_KEY=server-only-access-key
# CORPUS_S3_SECRET_KEY=server-only-secret-key
