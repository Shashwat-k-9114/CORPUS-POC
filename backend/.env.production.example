# Production environment variables for the Corpus backend (Render).
#
# Copy is illustrative only -- set the real value directly in the Render dashboard
# (Environment tab), never commit a real production value to this repo.

# Comma-separated list of browser origins allowed to call this API (CORS).
# Set this to the deployed Vercel frontend URL(s) once known, e.g.:
#   CORPUS_ALLOWED_ORIGINS=https://corpus-frontend.vercel.app
# A Vercel preview-deployment URL differs per branch/PR; add every origin that needs
# to reach this API, comma-separated, with no wildcard (see DECISIONS.md DEC-009 /
# DEPLOYMENT.md "CORS configuration").
CORPUS_ALLOWED_ORIGINS=https://REPLACE-WITH-DEPLOYED-VERCEL-URL.vercel.app
