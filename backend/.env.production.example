# Render production backend. Replace every sync=false value in the provider secret store.
CORPUS_ENVIRONMENT=production
CORPUS_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
CORPUS_BLOB_STORE_BACKEND=s3
CORPUS_BLOB_STORE_ROOT=/tmp/corpus-blobs
CORPUS_S3_ENDPOINT_URL=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
CORPUS_S3_REGION=us-east-1
CORPUS_S3_BUCKET=corpus-private
CORPUS_S3_ACCESS_KEY=server-only-access-key
CORPUS_S3_SECRET_KEY=server-only-secret-key
CORPUS_REVIEW_TOKEN=long-random-review-token
CORPUS_ALLOWED_ORIGINS=https://REPLACE-WITH-VERCEL-PROJECT.vercel.app
CORPUS_MAX_UPLOAD_SIZE_BYTES=52428800
CORPUS_RATE_LIMIT_PER_MINUTE=120
